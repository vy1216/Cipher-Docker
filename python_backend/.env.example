# CIPHER local development / production environment template
# NEVER commit a real .env file or real API/database secrets.

SECRET_KEY=replace-with-a-long-random-secret

# Local SQLite development: leave DATABASE_URL empty.
# For Supabase/Render production set DATABASE_URL to the Supabase connection string.
CIPHER_DB_FILE=./cipher.db
CIPHER_UPLOADS_DIR=./uploads
CIPHER_FRONTEND_DIR=./frontend
MAX_UPLOAD_BYTES=10485760
SEED_DEMO_DATA=false

# Supabase PostgreSQL + private evidence storage
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=cipher-evidence

# Browser origins allowed to call the API
CIPHER_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Evidence processing
# Render Free uses FastAPI background tasks inside the single web service; no separate worker is required.
CIPHER_USE_BACKGROUND_TASKS=true
CIPHER_WORKER_POLL_SECONDS=2
CIPHER_WORKER_BATCH_SIZE=2

# AI providers
# LLM provider chain: Gemini free -> OpenRouter free -> local Ollama
LLM_PROVIDER=auto
LLM_FALLBACK_ORDER=gemini,openrouter,ollama
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FALLBACKS=
GEMINI_TIMEOUT=30
GEMINI_MAX_OUTPUT_TOKENS=700
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_TIMEOUT=30
OPENROUTER_MAX_TOKENS=700
OPENROUTER_HTTP_REFERER=http://127.0.0.1:8000
OPENROUTER_APP_NAME=CIPHER Investigation Platform
GROQ_API_KEY=

# Neo4j AuraDB Free
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_REQUIRED_FOR_GRAPH=false

# CIPHER intelligence extensions
CIPHER_RAG_DIR=data/rag
CIPHER_EMBEDDING_MODEL=all-MiniLM-L6-v2
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=180
CIPHER_FACE_MODEL=buffalo_l

# Optional separate CIPHER ML LAB HTTP service
AI_MODEL_URL=http://127.0.0.1:8001
ML_MODEL_TIMEOUT=15
CIPHER_FACE_MATCH_THRESHOLD=0.45

# Face recognition
CIPHER_FACE_MODEL=buffalo_l
CIPHER_FACE_MODEL_ROOT=
CIPHER_FACE_PROVIDERS=CPUExecutionProvider
CIPHER_FACE_MATCH_THRESHOLD=0.45

# For grounded structured CIPHER answers, disable Qwen reasoning overhead by default.
OLLAMA_THINK=false
OLLAMA_NUM_PREDICT=600
